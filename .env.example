# Optional. Node >=22: node --env-file=.env server.mjs
# Copy this file to .env locally; never commit or share .env.
# Leave both blank to keep real AI requests disabled. Choose a Responses-compatible
# model available in your OpenAI account. API requests can incur costs.
OPENAI_API_KEY=
OPENAI_MODEL=
PORT=8787
# Optional public identifier for preview ONLY. Does not grant or verify access.
LINKEDIN_ORGANIZATION_URN=
# Default .packrivo-data, protected from the static web server.
# PACKRIVO_DATA_DIR=/absolute/private/path
# There is intentionally no live-publish switch or LinkedIn access-token setting.
# This review release cannot post even if unrelated environment flags are set.
